  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "status",
          "title",
          "error",
          "codigo",
          "nivel"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "description": "Igual que `error`."
          },
          "status": {
            "type": "integer",
            "description": "Código de estado HTTP."
          },
          "error": {
            "type": "string",
            "description": "Mensaje en español, listo para mostrar al usuario."
          },
          "codigo": {
            "type": "string",
            "description": "Identificador estable del error, por ejemplo `datos_invalidos`, `no_autenticado`, `sin_permiso`, `no_encontrado`, `conflicto`, `version_obsoleta`, `registro_duplicado` o `demasiados_intentos`."
          },
          "nivel": {
            "type": "string",
            "enum": [
              "api",
              "base_de_datos"
            ],
            "description": "Dónde se detectó el error. El nivel `formulario` lo agrega el frontend."
          },
          "errores": {
            "type": "object",
            "description": "Mensajes por campo, solo en errores de validación.",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "traceId": {
            "type": "string",
            "description": "Identificador de la petición, para ubicarla en los registros del servidor."
          }
        }
      },
      "ResultadoPaginado": {
        "type": "object",
        "required": [
          "elementos",
          "total",
          "pagina",
          "tamano",
          "totalPaginas"
        ],
        "properties": {
          "elementos": {
            "type": "array",
            "items": {}
          },
          "total": {
            "type": "integer"
          },
          "pagina": {
            "type": "integer"
          },
          "tamano": {
            "type": "integer"
          },
          "totalPaginas": {
            "type": "integer"
          }
        }
      }
    }
  }
