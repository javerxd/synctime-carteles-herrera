# Fase 16A: variables de compose.yaml. Copie este archivo a «.env» (lo hace scripts/crear-env.sh) y complete los vacios.
# «.env» NUNCA se sube a git (esta en .gitignore). Aqui no hay ningun valor secreto, solo los nombres y valores no sensibles.

# ---- Obligatorias (scripts/crear-env.sh las genera al azar) -----------------------------------------------------------
# Clave del usuario «sa» de SQL Server del contenedor. Letras y numeros, minimo 12, sin «;» ni comillas.
MSSQL_SA_PASSWORD=
# Clave que firma las sesiones (JWT). Minimo 32 caracteres.
JWT_KEY=
# Clave de los usuarios de demostracion (@letreria.test), de 8 a 72 caracteres.
DEMO_PASSWORD=

# ---- Opcionales -------------------------------------------------------------------------------------------------------
# Clave que cifra los vectores del rostro (32 bytes en base64). Sin ella, el ingreso con rostro queda deshabilitado.
ROSTRO_CLAVE=
# ID de cliente OAuth de Google (no es secreto, pero no se escribe en el repositorio). Sin el, no se muestra «Continuar con Google».
GOOGLE_CLIENT_ID=
# Direccion publica del sitio para el codigo QR del panel (por omision, el origen del sitio).
URL_PORTAL=
# Primer administrador, solo si la base NO termina en «_Demo» (en la de demostracion los usuarios los crea la semilla).
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Casilla que recibe los avisos del taller (el buzon de desarrollo la muestra en http://localhost:8025).
CORREO_AVISOS_TALLER=taller@synctime.local

# ---- Puertos y red (valores por omision) -----------------------------------------------------------------------------
WEB_PORT=8080
MAIL_UI_PORT=8025
SQL_DATABASE=SyncTime_Demo
# Red interna de compose; la API solo confia en las cabeceras X-Forwarded-* que vengan de aqui.
RED_INTERNA=172.30.0.0/24
