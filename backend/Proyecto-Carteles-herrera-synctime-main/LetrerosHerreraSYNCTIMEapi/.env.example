Jwt__Audience=SyncTimeFrontend

# Solo para crear el primer empleado: se usan si la tabla empleados esta vacia.
# Quitar la password despues del primer arranque.
# Bootstrap__Admin__Rut=
# Bootstrap__Admin__Nombre=
# Bootstrap__Admin__Apellido=
# Bootstrap__Admin__Telefono=
# Bootstrap__Admin__Email=
# Bootstrap__Admin__Password=

# Correo (fase 4). Valores listos para Gmail en appsettings.json: smtp.gmail.com, 587, STARTTLS.
# La cuenta que envia y su contraseña de aplicacion (no la contraseña normal de Google).
# Correo__Smtp__Usuario=
# Correo__Smtp__Password=
# Uno o mas correos que reciben los avisos del taller, separados por ";".
# Correo__AvisosTaller=
# Direccion del sitio, para los enlaces de los correos (por ejemplo https://synctime.cl).
# Sitio__UrlPublica=
