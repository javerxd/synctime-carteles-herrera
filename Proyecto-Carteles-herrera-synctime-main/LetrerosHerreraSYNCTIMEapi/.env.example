# ───── LetrerosHerreraSYNCTIMEapi - Variables de Entorno ─────
# Copie este archivo como .env y complete los valores reales.
# NUNCA suba el archivo .env al repositorio.

# Cadena de conexión a SQL Server
ConnectionStrings__DefaultConnection=Server=localhost;Database=LetrerosHerreraDB;Trusted_Connection=True;TrustServerCertificate=True;

# Configuración JWT
Jwt__Key=CAMBIE_ESTA_CLAVE_POR_UNA_SEGURA_DE_AL_MENOS_32_CARACTERES
Jwt__Issuer=LetrerosHerreraSYNCTIMEapi
Jwt__Audience=SyncTimeFrontend
