# URL base de la API (sin barra final)
# Vacía en desarrollo: el proxy de Vite sirve /api en el mismo origen, y así viaja la cookie de
# renovación de la sesión (fase 6). Solo se define si la API está en el mismo sitio del portal.
# VITE_API_URL=

# Dirección pública del portal, la que codifica el QR del panel (por defecto, el origen del sitio)
# VITE_URL_PORTAL=https://letrerosherrera.cl/

# Dashboard de indicadores (fase 12): mientras el backend de /api/v1/indicadores no exista (fase 12A), la pantalla
# usa datos de demostración y lo avisa. Sin la variable, la demo se enciende SOLO en desarrollo (npm run dev) y en
# las pruebas; un build de producción usa la API real salvo que se ponga en true. En la 12B: false (o sin definir).
# VITE_INDICADORES_DEMO=true
