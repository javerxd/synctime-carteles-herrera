# Fase 16A (RNFP25): sitio del frontend en nginx sin privilegios. La imagen oficial sustituye ${API_UPSTREAM} y ${DNS_RESOLVER}
# (variables de entorno) al arrancar y deja el resultado en /etc/nginx/conf.d/default.conf.
# Cualquier otro «$» de este archivo es de nginx y no se toca: solo se sustituyen las variables que existen en el entorno.

server {
    listen 8080;
    server_name _;
    server_tokens off;
    absolute_redirect off;

    root /usr/share/nginx/html;
    index index.html;

    # Compresion. (La imagen oficial no trae Brotli; gzip llega a todos los navegadores.)
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml;

    include /etc/nginx/snippets/cabeceras-seguridad.conf;

    # La API, en el mismo origen que el sitio (como lo hace la reescritura de Vercel): la cookie de renovacion de la
    # sesion viaja sin CORS. Docker resuelve «api» con su DNS interno; con una variable, nginx vuelve a resolver el
    # nombre y no falla al arrancar si la API aun no esta lista.
    location ^~ /api/ {
        resolver ${DNS_RESOLVER} valid=10s ipv6=off;
        set $destino_api ${API_UPSTREAM};
        proxy_pass $destino_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Se SOBRESCRIBE (no se agrega a lo que traiga el visitante): quien llega a este nginx no es un proxy de confianza.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        client_max_body_size 16m;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # Archivos con huella en el nombre (Vite): el contenido nunca cambia bajo el mismo nombre, asi que se guardan un ano.
    # Solo aqui: lo demas puede cambiar. Un archivo que no existe es 404 (no se devuelve index.html con tipo de JavaScript).
    location ^~ /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/snippets/cabeceras-seguridad.conf;
    }

    # El documento de entrada apunta a los archivos con huella: debe revisarse en cada visita para ver las versiones nuevas.
    location = /index.html {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/cabeceras-seguridad.conf;
    }

    # Imagenes, fuentes y modelos del reconocimiento facial de /public: sin huella, se guardan un dia.
    location ~* \.(?:png|jpe?g|webp|avif|gif|svg|ico|woff2?|json|bin|txt|webmanifest)$ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=86400" always;
        include /etc/nginx/snippets/cabeceras-seguridad.conf;
    }

    # Las rutas de la aplicacion (/panel, /cuenta, ...) no son archivos: se entrega la aplicacion y su enrutador decide.
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/cabeceras-seguridad.conf;
    }
}
