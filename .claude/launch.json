{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "frontend/synctimefront"
      ],
      "port": 3000
    },
    {
      "name": "api-demo",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "backend/Proyecto-Carteles-herrera-synctime-main/LetrerosHerreraSYNCTIMEapi",
        "--launch-profile",
        "https"
      ],
      "port": 7112
    },
    {
      "name": "api-demo-avisos",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "backend/Proyecto-Carteles-herrera-synctime-main/LetrerosHerreraSYNCTIMEapi",
        "--launch-profile",
        "https",
        "--",
        "--Correo:AvisosTaller=avisos.demo@letreria.test",
        "--Correo:Modo=Bandeja"
      ],
      "port": 7112
    },
    {
      "name": "api-demo-rostro",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "backend/Proyecto-Carteles-herrera-synctime-main/LetrerosHerreraSYNCTIMEapi",
        "--launch-profile",
        "https",
        "--",
        "--Correo:AvisosTaller=avisos.demo@letreria.test",
        "--Correo:Modo=Bandeja",
        "--RostroFacial:Calibracion:Activa=true"
      ],
      "port": 7112
    }
  ]
}